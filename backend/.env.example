# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Language model providers. Both are free to obtain:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
# The router tries them in LLM_PROVIDER_ORDER and fails over automatically,
# so configuring either one is enough to run.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER_ORDER=gemini,groq
# Override the default models if a provider retires one:
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=openai/gpt-oss-120b

# Detection. DETECTION_DEVICE accepts auto, cuda or cpu; auto falls back to
# CPU when no GPU is present or the GPU has too little memory.
DETECTION_DEVICE=auto
DETECTOR_WEIGHTS=yolov8s-obb.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
TILE_SIZE=640
TILE_OVERLAP=0.2

DATABASE_URL=sqlite+aiosqlite:///./orbital_recon.db
CORS_ORIGINS=http://localhost:5173
